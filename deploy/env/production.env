# Production configuration (non-secret values only; secrets come from Jenkins credentials)
APP_ENV=production
LOG_LEVEL=info
DB_PATH=/app/data/bookstore.db
# Local demo runs over plain HTTP; set true behind HTTPS in a real deployment.
COOKIE_SECURE=false
# Chaos endpoints are enabled ONLY so the Monitoring stage can simulate an
# incident for the assessment demo. In a real production system this must be false.
CHAOS_ENABLED=true
ADMIN_EMAILS=admin@bookstore.local
# Max FAILED login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT=20

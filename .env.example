# Copy to .env (git-ignored) and change the values.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-jenkins

# Generate in SonarQube: My Account -> Security -> Generate Token (type: Global Analysis)
# then restart Jenkins:  docker compose -f docker-compose.infra.yml up -d jenkins
SONAR_TOKEN=paste-sonar-token-here

# express-session signing secrets, injected by Jenkins per environment (different per env!)
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
STAGING_SESSION_SECRET=replace-with-random-staging-secret
PROD_SESSION_SECRET=replace-with-random-prod-secret

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
